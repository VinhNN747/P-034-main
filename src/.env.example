# ============================================
# AI20K Project — Environment Variables
# ============================================
# From the repository root: cp src/.env.example .env, then fill in your values
# NEVER commit .env to git!

# ---- Provider credential encryption ----
# Live mode requires this unique key. Use the same value for every backend/worker
# connected to this database. Generate once; see README.md#provider-credentials.
CREDENTIAL_ENCRYPTION_KEY=

# Provider and JEV keys are managed by admins under /providers and encrypted in
# PostgreSQL. Legacy env names are read only by the explicit import CLI.
# Gemini 3.6 Flash is added to the database model pool by src/scripts/seed_backend.py.
SUPPORT_CHAT_LLM_ENABLED=true
SUPPORT_CHAT_MODEL=gpt-5.6-luna
SUPPORT_CHAT_LLM_TIMEOUT_SECONDS=75
SUPPORT_CHAT_REASONING_EFFORT=medium
SUPPORT_CHAT_ANSWER_MAX_TOKENS=6000
SUPPORT_CHAT_RETRIEVAL_CHUNKS=8
SUPPORT_CHAT_EVIDENCE_CHARS=24000
SUPPORT_CHAT_RESPONSE_TEMPERATURE=0.45
SUPPORT_CHAT_EMBEDDING_MODEL=text-embedding-3-small
SUPPORT_CHAT_HISTORY_MESSAGES=32
SUPPORT_CHAT_CONTEXT_CHARS=32000
SUPPORT_CHAT_INTENT_THRESHOLD=0.75
SUPPORT_CHAT_SEMANTIC_THRESHOLD=0.35
SUPPORT_CHAT_REQUESTS_PER_MINUTE=20
SUPPORT_CHAT_UTC_OFFSET_MINUTES=420

# ---- Supabase PostgreSQL ----
# Shared by Auth/RBAC and the Core/Gateway SQLAlchemy repositories.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# ============================================
# Gateway pipeline: Online or Offline (see ARCHITECTURE.md at the repository root)
# ============================================
# One pipeline per process. online (= live): LLM / jev understanding, external providers.
# offline: nothing leaves the deployment: local task classifier, deterministic decomposition and
# aggregation, self-hosted endpoints (vLLM / Ollama / OpenAI-compatible) or the offline stub.
# An application's understander/decomposer/aggregator live in its gateway config (database); the
# offline pipeline maps jev/llm onto its own stages and reports PIPELINE_STRATEGY_SUBSTITUTED.
# Only the [Common] section and the section of the selected pipeline are read.
GATEWAY_EXECUTION_MODE=online

# ---- [Common] both pipelines ----
# Required for native runtime and OpenAI-compatible endpoints; restart after changing it.
GATEWAY_RUNTIME_ENABLED=true
# Comparison queue runs inside Backend AI; no extra terminal is needed.
COMPARISON_WORKER_ENABLED=true
COMPARISON_WORKER_POLL_SECONDS=2
COMPARISON_WORKER_SHUTDOWN_SECONDS=30
COMPARISON_EVALUATION_MAX_OUTPUT_TOKENS=4096
# Runtime model metadata, pricing and provider mappings are read from PostgreSQL.
# Use the model catalog API or src/scripts/seed_backend.py to manage bootstrap data.
# Execution timeout of one model call.
GATEWAY_ROUTING_TIMEOUT_SECONDS=30
# Conversation routing window: routing judges the latest user ask, not the whole history.
GATEWAY_ROUTING_MESSAGE_COUNTBACK=1
GATEWAY_ROUTING_CONTEXT_MESSAGES=2
GATEWAY_ROUTING_CONTEXT_MAX_CHARS=1500
GATEWAY_ROUTING_INCLUDE_SYSTEM_PROMPT=false
# Self-hosted model servers (customer endpoints / local connections). false on a hosted, multi-tenant
# deployment (public HTTPS only); true for a self-hosted gateway next to its own vLLM / Ollama.
GATEWAY_LOCAL_ENDPOINTS_ALLOW_PRIVATE=false
# Attachments: PDF text layers and text files are read in both pipelines (OCR is online only).
GATEWAY_ATTACHMENT_MAX_BYTES=20971520
GATEWAY_PDF_TEXT_LAYER_MIN_CHARS_PER_PAGE=200
# Files API (/v1/files): upload once, reference by file_id. Files expire after 1 day by default.
# /v1 body cap (inline base64 images); prefer /v1/files + file_id for large files.
GATEWAY_OPENAI_MAX_BODY_BYTES=33554432
GATEWAY_FILES_STORAGE=local
GATEWAY_FILES_LOCAL_DIR=./data/files
# S3 (or MinIO/R2 via endpoint URL); empty keys fall back to the normal AWS credential chain.
GATEWAY_FILES_S3_BUCKET=
GATEWAY_FILES_S3_PREFIX=gateway-files
GATEWAY_FILES_S3_REGION=
GATEWAY_FILES_S3_ENDPOINT_URL=
GATEWAY_FILES_S3_ACCESS_KEY_ID=
GATEWAY_FILES_S3_SECRET_ACCESS_KEY=
GATEWAY_FILES_MAX_BYTES=52428800
GATEWAY_FILES_APPLICATION_QUOTA_BYTES=1073741824
GATEWAY_FILES_DEFAULT_TTL_SECONDS=86400
GATEWAY_FILES_MIN_TTL_SECONDS=3600
GATEWAY_FILES_MAX_TTL_SECONDS=604800
# Per-model circuit breaker (process-wide): skip a failing model instead of waiting for its timeout.
GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
GATEWAY_CIRCUIT_WINDOW_SECONDS=60
GATEWAY_CIRCUIT_OPEN_SECONDS=30
GATEWAY_CIRCUIT_MAX_OPEN_SECONDS=300

# ---- [Online] read only with GATEWAY_EXECUTION_MODE=online ----
# Provider and JEV keys are managed by admins under /providers and encrypted in PostgreSQL.
# Execute: external providers.
GATEWAY_OPENAI_ENABLED=true
GATEWAY_GEMINI_ENABLED=true
GATEWAY_ANTHROPIC_ENABLED=true
# Fallback model for Anthropic provider connection probes when Model ID is blank.
GATEWAY_ANTHROPIC_PROBE_MODEL=claude-haiku-5-5
# Understand / Decompose / Aggregate with an LLM (strategy "llm").
GATEWAY_LLM_TIMEOUT_SECONDS=30
GATEWAY_LLM_MAX_RETRIES=1
# jev scores each request 0..3 (reasoning, domain, ambiguity, risk, output); TierPolicy picks the tier.
# Thresholds: >= HIGH counts as high, >= VERY_HIGH as very high.
GATEWAY_JEV_ENABLED=true
GATEWAY_JEV_MODEL=jev-latest
GATEWAY_JEV_TIMEOUT_SECONDS=2
GATEWAY_JEV_MAX_STATE_CHARS=40000
GATEWAY_JEV_INPUT_PRICE_PER_MILLION_USD=0.042
GATEWAY_TIER_POLICY_HIGH=1.9
GATEWAY_TIER_POLICY_VERY_HIGH=2.7
# 0 disables A3 (one tier up when jev confidence is below this).
GATEWAY_TIER_POLICY_MIN_CONFIDENCE=0
# Decompose: goal extraction 'unclear' (e.g. two asks joined by 'and'): jev's multi-task probability decides.
GATEWAY_JEV_MULTI_TASK_THRESHOLD=0.7
GATEWAY_JEV_SINGLE_TASK_THRESHOLD=0.3
# OCR for image/PDF content parts (Gemini 3.8 Flash); without it images are skipped.
GATEWAY_OCR_ENABLED=false
# Introductory prices through 2026-12-31; update to $1.50/$7.50 per million starting 2027-01-01.
GATEWAY_OCR_MODEL=gemini-3.8-flash
GATEWAY_OCR_TIMEOUT_SECONDS=60
GATEWAY_OCR_MAX_OUTPUT_TOKENS=8192
GATEWAY_OCR_INPUT_PRICE_PER_MILLION_USD=0.75
GATEWAY_OCR_OUTPUT_PRICE_PER_MILLION_USD=3.75
GATEWAY_PDF_MAX_OCR_PAGES=50
# Task classifier as a service (src/classifier_service/ on Modal or Cloud Run):
# the gateway then needs no model RAM. TOKEN = the service's
# CLASSIFIER_TOKEN. Past the timeout (e.g. a cold start) that request is routed on the rules.
# Both pipelines use it when set. Offline sends only the prompt's focus text there (nothing else
# leaves); for fully in-house offline, leave it empty and use GATEWAY_TASK_CLASSIFIER_DIR below.
GATEWAY_TASK_CLASSIFIER_URL=
GATEWAY_TASK_CLASSIFIER_TOKEN=
GATEWAY_TASK_CLASSIFIER_TIMEOUT_SECONDS=5
# Adaptive provider-attempt latency learning. Auto collects, trains and uses predictions
# only after per-profile gates pass.
GATEWAY_LATENCY_MODE=auto
GATEWAY_LATENCY_TRAINING_ENABLED=true
GATEWAY_LATENCY_REGION=unspecified
# Training is supervised in a child process owned by Backend AI; no extra service is needed.
# GATEWAY_LATENCY_TRAINING_INTERVAL_SECONDS=3600
# GATEWAY_LATENCY_MIN_TRAINING_SAMPLES=500
# GATEWAY_LATENCY_MIN_NEW_SAMPLES=200
# GATEWAY_LATENCY_MIN_COMMON_VALIDATION_SAMPLES=100

# ---- [Offline] read only with GATEWAY_EXECUTION_MODE=offline ----
# (The local classifier below also serves an online application whose understander is "classifier"
# when GATEWAY_TASK_CLASSIFIER_URL is empty.)
# Understand: task classifier (BERT/ONNX, CPU, ~0.7 GiB RAM). The files are not in git:
# src/scripts/fetch_task_classifier.py downloads them into the dir from a private Hugging Face repo.
# SOURCE_URL e.g. https://huggingface.co/<user>/<repo>/resolve/<commit>; SOURCE_TOKEN = a read-only
# HF token, server-only. Unset dir = the rules. REQUIRED=true refuses to start without the model.
GATEWAY_TASK_CLASSIFIER_DIR=
GATEWAY_TASK_CLASSIFIER_SOURCE_URL=
GATEWAY_TASK_CLASSIFIER_SOURCE_TOKEN=
GATEWAY_TASK_CLASSIFIER_REQUIRED=false
GATEWAY_TASK_CLASSIFIER_THREADS=2
# false = ~360 MiB less RAM (slightly slower long prompts).
GATEWAY_TASK_CLASSIFIER_MEM_ARENA=true
# Route: the classifier's difficulty -> tier (below MID: small, below LARGE: mid, else large),
# per task type as JSON, e.g. '{"coding": [0.2, 0.5]}'.
GATEWAY_CLASSIFIER_MID_DIFFICULTY=0.23
GATEWAY_CLASSIFIER_LARGE_DIFFICULTY=0.61
GATEWAY_CLASSIFIER_TASK_THRESHOLDS={}
# Execute: the application's pool must hold models on self-hosted endpoints ("local" connections /
# /my-endpoints); see GATEWAY_LOCAL_ENDPOINTS_ALLOW_PRIVATE in [Common].

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
# Server-side Next.js proxies always call management.
BACKEND_API_URL=http://127.0.0.1:8000

# ---- OpenAI-compatible Python client example ----
GATEWAY_OPENAI_BASE_URL=http://127.0.0.1:8001/v1
# Replace with an active Gateway application API key.
GATEWAY_API_KEY=ak_your_application_gateway_key
# ---- Supabase Auth ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
# Server-only. Use the legacy service_role key or the newer sb_secret_... key.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- Resend budget alert email ----
# Use a sender address on a verified Resend domain, e.g. alerts@example.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
BUDGET_ALERT_ENABLED=true

# ---- Management -> AI (server-only; same token on both services) ----
AI_BACKEND_URL=http://127.0.0.1:8001
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
AI_BACKEND_TIMEOUT_SECONDS=40
